<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>บ้านสวนกาแฟ & พิซซ่าเตาฟืน (บ้านมอเศรษฐี) - ระบบสั่งอาหารและจัดการร้าน</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Kanit & Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- QRCode.js สำหรับสร้าง QR Code ประจำโต๊ะ -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    
    <style>
        body {
            font-family: 'Kanit', 'Inter', sans-serif;
            background-color: #faf7f2;
            color: #292524;
        }
        /* ซ่อน Scrollbar แต่ยังเลื่อนได้ */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        @keyframes pulse-ring {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(234, 88, 12, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(234, 88, 12, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(234, 88, 12, 0); }
        }
        .new-order-badge {
            animation: pulse-ring 2s infinite;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- แถบนำทางด้านบน (Navbar) -->
    <header class="bg-stone-900 text-white sticky top-0 z-40 shadow-md">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-2">
            <!-- กดที่โลโก้ร้านเพื่อเปิดหน้าต่างใส่รหัส PIN เข้าสู่ระบบร้านค้า -->
            <div onclick="openMerchantAuthModal()" class="flex items-center gap-3 cursor-pointer select-none group" title="สำหรับพนักงาน/เจ้าของร้าน">
                <div class="bg-amber-600 p-2 rounded-xl group-hover:bg-amber-500 transition">
                    <i data-lucide="coffee" class="w-6 h-6 text-white"></i>
                </div>
                <div>
                    <h1 class="text-base sm:text-xl font-bold tracking-wide text-amber-500">บ้านสวนกาแฟ & พิซซ่าเตาฟืน</h1>
                    <p class="text-xs text-stone-400">บ้านมอเศรษฐี</p>
                </div>
            </div>

            <!-- แถบสถานะสำหรับฝั่งร้านค้า (จะแสดงเฉพาะเมื่อล็อกอินเข้าโหมดร้านค้าแล้วเท่านั้น) -->
            <div id="merchant-mode-controls" class="hidden flex items-center gap-2">
                <span class="text-xs bg-amber-600/20 text-amber-400 border border-amber-500/30 px-3 py-1.5 rounded-lg font-medium flex items-center gap-1.5">
                    <i data-lucide="shield-check" class="w-4 h-4"></i> โหมดร้านค้า (POS)
                </span>
                <button onclick="logoutMerchant()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-stone-800 hover:bg-red-600 text-stone-300 hover:text-white border border-stone-700 transition">
                    <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
                    <span>ออกจากระบบร้านค้า</span>
                </button>
            </div>
        </div>
    </header>

    <!-- กล่องแจ้งเตือน (Toast Notification) -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- ========================================== -->
    <!-- ส่วนที่ 1: หน้าจอฝั่งลูกค้า (Customer View)    -->
    <!-- ========================================== -->
    <main id="view-customer" class="flex-1 max-w-7xl w-full mx-auto px-4 py-6 pb-28">
        
        <!-- แบนเนอร์แสดงเลขโต๊ะ (จำลองการสแกน QR Code) -->
        <div class="bg-gradient-to-r from-amber-700 to-stone-800 rounded-2xl p-5 text-white mb-6 shadow-lg flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
                <div class="flex items-center gap-2 text-amber-300 text-sm font-medium mb-1">
                    <i data-lucide="qr-code" class="w-4 h-4"></i>
                    <span>สั่งอาหารผ่าน QR Code</span>
                </div>
                <h2 class="text-xl sm:text-2xl font-bold">ยินดีต้อนรับสู่ บ้านสวนกาแฟ & พิซซ่าเตาฟืน!</h2>
                <p class="text-stone-200 text-sm mt-1">บ้านมอเศรษฐี • เลือกเมนูเครื่องดื่มและพิซซ่าอบเตาฟืน แล้วกดสั่งให้ส่งตรงถึงโต๊ะของคุณ</p>
            </div>
            <div class="bg-white/10 backdrop-blur-md border border-white/20 p-3 rounded-xl flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-start">
                <span class="text-sm text-amber-200">คุณอยู่ที่:</span>
                <!-- กรณีสแกน QR Code มา จะล็อกเลขโต๊ะให้อัตโนมัติ -->
                <div id="locked-table-badge" class="hidden bg-stone-900 text-amber-400 font-bold px-4 py-1.5 rounded-lg border border-amber-500/50 flex items-center gap-1.5">
                    <i data-lucide="map-pin" class="w-4 h-4"></i>
                    <span id="locked-table-text">โต๊ะ 1</span>
                </div>
                <select id="customer-table-select" onchange="updateCustomerTable(this.value)" class="bg-stone-900 text-white font-bold px-3 py-1.5 rounded-lg border border-amber-500/50 focus:outline-none">
                    <option value="โต๊ะ 1">โต๊ะ 1</option>
                    <option value="โต๊ะ 2">โต๊ะ 2</option>
                    <option value="โต๊ะ 3">โต๊ะ 3</option>
                    <option value="โต๊ะ 4">โต๊ะ 4</option>
                    <option value="โต๊ะ 5">โต๊ะ 5</option>
                    <option value="สั่งกลับบ้าน (Takeaway)">สั่งกลับบ้าน</option>
                </select>
            </div>
        </div>

        <!-- หมวดหมู่เมนูและช่องค้นหา -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 mb-6">
            <div class="flex gap-2 overflow-x-auto no-scrollbar pb-1">
                <button onclick="filterCategory('all')" id="cat-all" class="cat-btn px-4 py-2 rounded-xl font-medium text-sm whitespace-nowrap bg-stone-900 text-white shadow-sm transition">
                    ทั้งหมด
                </button>
                <button onclick="filterCategory('coffee')" id="cat-coffee" class="cat-btn px-4 py-2 rounded-xl font-medium text-sm whitespace-nowrap bg-white text-stone-700 hover:bg-stone-100 border border-stone-200 transition flex items-center gap-1.5">
                    <i data-lucide="cup-soda" class="w-4 h-4 text-amber-600"></i> เครื่องดื่ม & กาแฟ
                </button>
                <button onclick="filterCategory('pizza')" id="cat-pizza" class="cat-btn px-4 py-2 rounded-xl font-medium text-sm whitespace-nowrap bg-white text-stone-700 hover:bg-stone-100 border border-stone-200 transition flex items-center gap-1.5">
                    <i data-lucide="pizza" class="w-4 h-4 text-orange-600"></i> พิซซ่า & ของทานเล่น
                </button>
            </div>

            <div class="relative">
                <i data-lucide="search" class="w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                <input type="text" id="customer-search" oninput="renderCustomerMenu()" placeholder="ค้นหาเมนู..." class="w-full sm:w-64 pl-10 pr-4 py-2 bg-white border border-stone-200 rounded-xl text-sm focus:outline-none focus:border-amber-600">
            </div>
        </div>

        <!-- รายการเมนูอาหาร (Grid) -->
        <div id="customer-menu-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
            <!-- จะถูกเติมด้วย JavaScript -->
        </div>

        <!-- แถบติดตามสถานะออเดอร์ล่าสุดของโต๊ะนี้ -->
        <div id="customer-active-orders" class="mt-10 hidden">
            <h3 class="text-lg font-bold text-stone-800 mb-3 flex items-center gap-2">
                <i data-lucide="clock" class="w-5 h-5 text-amber-600"></i>
                รายการที่สั่งไปแล้ว (<span id="active-order-table-label">โต๊ะ 1</span>)
            </h3>
            <div id="customer-orders-list" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
        </div>

        <!-- ปุ่มตะกร้าสินค้าลอยด้านล่าง (Floating Cart Bar) -->
        <div id="floating-cart-bar" class="fixed bottom-4 left-4 right-4 max-w-3xl mx-auto bg-stone-900 text-white p-4 rounded-2xl shadow-2xl border border-stone-700 flex items-center justify-between transition-transform duration-300 translate-y-32 z-30">
            <div class="flex items-center gap-3">
                <div class="relative bg-amber-600 p-2.5 rounded-xl">
                    <i data-lucide="shopping-bag" class="w-6 h-6 text-white"></i>
                    <span id="cart-badge-count" class="absolute -top-2 -right-2 bg-red-500 text-white text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center">0</span>
                </div>
                <div>
                    <p class="text-xs text-stone-400">ยอดรวมตะกร้า (<span id="cart-table-name">โต๊ะ 1</span>)</p>
                    <p class="text-lg font-bold text-amber-400">฿<span id="cart-total-price">0</span></p>
                </div>
            </div>
            <button onclick="openCartModal()" class="bg-amber-600 hover:bg-amber-500 text-white font-semibold px-6 py-2.5 rounded-xl transition flex items-center gap-2 shadow-lg">
                <span>ดูตะกร้า & สั่งเลย</span>
                <i data-lucide="chevron-right" class="w-4 h-4"></i>
            </button>
        </div>
    </main>

    <!-- ========================================== -->
    <!-- Modal: ตะกร้าสินค้าฝั่งลูกค้า (Cart Modal)     -->
    <!-- ========================================== -->
    <div id="cart-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-end sm:items-center justify-center p-0 sm:p-4">
        <div class="bg-white w-full max-w-lg rounded-t-3xl sm:rounded-3xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <div class="p-5 bg-stone-900 text-white flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <i data-lucide="shopping-bag" class="w-5 h-5 text-amber-500"></i>
                    <h3 class="font-bold text-lg">รายการที่เลือก (<span id="modal-table-label">โต๊ะ 1</span>)</h3>
                </div>
                <button onclick="closeCartModal()" class="p-1.5 rounded-lg hover:bg-stone-800 text-stone-400 hover:text-white">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            
            <div id="cart-items-container" class="p-5 overflow-y-auto flex-1 space-y-3">
                <!-- รายการในตะกร้า -->
            </div>

            <div class="p-5 bg-stone-50 border-t border-stone-200 space-y-4">
                <div>
                    <label class="text-xs font-medium text-stone-500 block mb-1">หมายเหตุถึงร้านค้า (เช่น หวานน้อย, ไม่ใส่ผัก)</label>
                    <input type="text" id="order-note" placeholder="ระบุรายละเอียดเพิ่มเติม..." class="w-full px-3.5 py-2 bg-white border border-stone-300 rounded-xl text-sm focus:outline-none focus:border-amber-600">
                </div>
                <div class="flex items-center justify-between text-lg font-bold">
                    <span>ยอดชำระทั้งหมด</span>
                    <span class="text-amber-700 text-2xl">฿<span id="modal-total-price">0</span></span>
                </div>
                <button onclick="submitOrder()" id="btn-submit-order" class="w-full bg-amber-600 hover:bg-amber-700 text-white font-bold py-3.5 rounded-xl shadow-lg transition flex items-center justify-center gap-2 text-base">
                    <i data-lucide="send" class="w-5 h-5"></i>
                    <span>ยืนยันส่งออเดอร์เข้าครัวทันที</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- ส่วนที่ 2: หน้าจอฝั่งร้านค้า (Merchant POS)   -->
    <!-- ========================================== -->
    <main id="view-merchant" class="hidden flex-1 max-w-7xl w-full mx-auto px-4 py-6">
        
        <!-- เมนูย่อยฝั่งร้านค้า -->
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6 bg-white p-3 rounded-2xl shadow-sm border border-stone-200">
            <div class="flex flex-wrap gap-2">
                <button onclick="switchMerchantTab('orders')" id="tab-merchant-orders" class="merchant-tab px-4 py-2 rounded-xl font-medium text-sm bg-stone-900 text-white flex items-center gap-2">
                    <i data-lucide="bell-ring" class="w-4 h-4 text-amber-400"></i>
                    <span>ออเดอร์เข้าใหม่</span>
                    <span id="pending-orders-count" class="bg-red-500 text-white text-xs px-2 py-0.5 rounded-full">0</span>
                </button>
                <button onclick="switchMerchantTab('menu')" id="tab-merchant-menu" class="merchant-tab px-4 py-2 rounded-xl font-medium text-sm bg-stone-100 text-stone-700 hover:bg-stone-200 flex items-center gap-2">
                    <i data-lucide="plus-circle" class="w-4 h-4 text-amber-600"></i>
                    <span>จัดการเมนู & เพิ่มรูปภาพ</span>
                </button>
                <button onclick="switchMerchantTab('qr')" id="tab-merchant-qr" class="merchant-tab px-4 py-2 rounded-xl font-medium text-sm bg-stone-100 text-stone-700 hover:bg-stone-200 flex items-center gap-2">
                    <i data-lucide="qr-code" class="w-4 h-4 text-stone-600"></i>
                    <span>QR Code ประจำโต๊ะ</span>
                </button>
            </div>
            <div class="text-xs text-stone-500 flex items-center gap-1.5 px-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                เชื่อมต่อระบบรับออเดอร์สด
            </div>
        </div>

        <!-- แท็บย่อย 2.1: กระดานรับออเดอร์แบบเรียลไทม์ -->
        <section id="merchant-section-orders" class="space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- คอลัมน์: ออเดอร์ใหม่ -->
                <div class="bg-stone-100/80 p-4 rounded-2xl border border-stone-200">
                    <h3 class="font-bold text-stone-800 mb-3 flex items-center justify-between">
                        <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-red-500"></span> รอรับออเดอร์</span>
                        <span id="count-pending" class="text-xs bg-white px-2.5 py-1 rounded-lg border font-semibold">0</span>
                    </h3>
                    <div id="list-orders-pending" class="space-y-3"></div>
                </div>

                <!-- คอลัมน์: กำลังทำ -->
                <div class="bg-stone-100/80 p-4 rounded-2xl border border-stone-200">
                    <h3 class="font-bold text-stone-800 mb-3 flex items-center justify-between">
                        <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-amber-500"></span> กำลังชง / อบพิซซ่า</span>
                        <span id="count-preparing" class="text-xs bg-white px-2.5 py-1 rounded-lg border font-semibold">0</span>
                    </h3>
                    <div id="list-orders-preparing" class="space-y-3"></div>
                </div>

                <!-- คอลัมน์: เสิร์ฟแล้ว -->
                <div class="bg-stone-100/80 p-4 rounded-2xl border border-stone-200">
                    <h3 class="font-bold text-stone-800 mb-3 flex items-center justify-between">
                        <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-emerald-500"></span> เสิร์ฟเรียบร้อย</span>
                        <span id="count-completed" class="text-xs bg-white px-2.5 py-1 rounded-lg border font-semibold">0</span>
                    </h3>
                    <div id="list-orders-completed" class="space-y-3 max-h-[600px] overflow-y-auto pr-1"></div>
                </div>
            </div>
        </section>

        <!-- แท็บย่อย 2.2: เพิ่มเมนูใหม่พร้อมรูปภาพและราคา -->
        <section id="merchant-section-menu" class="hidden">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- ฟอร์มเพิ่มเมนูใหม่ -->
                <div class="lg:col-span-5 bg-white p-6 rounded-2xl shadow-sm border border-stone-200 h-fit">
                    <h3 class="text-lg font-bold text-stone-900 mb-4 flex items-center gap-2">
                        <i data-lucide="plus-square" class="w-5 h-5 text-amber-600"></i>
                        เพิ่มเมนูใหม่เข้าร้าน
                    </h3>
                    <form id="add-menu-form" onsubmit="handleAddMenu(event)" class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-stone-700 mb-1">ชื่อเมนู *</label>
                            <input type="text" id="menu-name" required placeholder="เช่น ลาเต้เย็น, พิซซ่าฮาวายเอี้ยน" class="w-full px-3.5 py-2 border border-stone-300 rounded-xl text-sm focus:outline-none focus:border-amber-600">
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-sm font-medium text-stone-700 mb-1">หมวดหมู่ *</label>
                                <select id="menu-category" class="w-full px-3.5 py-2 border border-stone-300 rounded-xl text-sm focus:outline-none focus:border-amber-600 bg-white">
                                    <option value="coffee">เครื่องดื่ม & กาแฟ</option>
                                    <option value="pizza">พิซซ่า & ของทานเล่น</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-stone-700 mb-1">ราคา (บาท) *</label>
                                <input type="number" id="menu-price" required min="1" placeholder="85" class="w-full px-3.5 py-2 border border-stone-300 rounded-xl text-sm focus:outline-none focus:border-amber-600">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-stone-700 mb-1">คำอธิบายสั้นๆ</label>
                            <input type="text" id="menu-desc" placeholder="เช่น เมล็ดกาแฟคั่วกลาง หอมนุ่มละมุน" class="w-full px-3.5 py-2 border border-stone-300 rounded-xl text-sm focus:outline-none focus:border-amber-600">
                        </div>

                        <!-- อัปโหลดรูปภาพหรือใส่ URL -->
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-stone-700">รูปภาพเมนู</label>
                            <div class="border-2 border-dashed border-stone-300 rounded-xl p-4 text-center hover:bg-stone-50 transition cursor-pointer relative" onclick="document.getElementById('menu-image-file').click()">
                                <input type="file" id="menu-image-file" accept="image/*" class="hidden" onchange="previewImageUpload(event)">
                                <div id="image-preview-placeholder" class="space-y-1">
                                    <i data-lucide="image-plus" class="w-8 h-8 text-stone-400 mx-auto"></i>
                                    <p class="text-xs text-stone-600 font-medium">คลิกเพื่อเลือกรูปภาพจากเครื่อง</p>
                                    <p class="text-[11px] text-stone-400">รองรับไฟล์ JPG, PNG (ย่อขนาดอัตโนมัติ)</p>
                                </div>
                                <img id="image-preview-img" class="hidden w-full h-40 object-cover rounded-lg mx-auto" alt="Preview">
                            </div>
                            <div class="text-center text-xs text-stone-400">หรือวางลิงก์รูปภาพ (Image URL)</div>
                            <input type="url" id="menu-image-url" oninput="previewImageUrl(this.value)" placeholder="https://example.com/pizza.jpg" class="w-full px-3.5 py-2 border border-stone-300 rounded-xl text-xs focus:outline-none focus:border-amber-600">
                        </div>

                        <button type="submit" class="w-full bg-stone-900 hover:bg-amber-600 text-white font-semibold py-3 rounded-xl transition shadow-md flex items-center justify-center gap-2">
                            <i data-lucide="save" class="w-4 h-4"></i>
                            <span>บันทึกเมนูใหม่</span>
                        </button>
                    </form>
                </div>

                <!-- รายการเมนูทั้งหมดในร้าน -->
                <div class="lg:col-span-7 bg-white p-6 rounded-2xl shadow-sm border border-stone-200">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-bold text-stone-900">รายการเมนูทั้งหมดในร้าน (<span id="merchant-menu-count">0</span>)</h3>
                    </div>
                    <div id="merchant-menu-list" class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-h-[650px] overflow-y-auto pr-1">
                        <!-- เติมด้วย JS -->
                    </div>
                </div>
            </div>
        </section>

        <!-- แท็บย่อย 2.3: QR Code ประจำโต๊ะ -->
        <section id="merchant-section-qr" class="hidden">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-stone-200">
                <div class="max-w-2xl mb-6">
